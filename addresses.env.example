# Minor Kime AgriFund — Contract Addresses
# Copy this file to addresses.env and fill in the values.
# addresses.env is gitignored — never commit real secrets.

# ── Stellar credentials ───────────────────────────────────────────────────────
STELLAR_PLATFORM_SECRET=S...
STELLAR_NETWORK=testnet

# ── RPC endpoint ──────────────────────────────────────────────────────────────
# Testnet (default):
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet:
# SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com

# ── Token contracts ───────────────────────────────────────────────────────────
# Testnet USDC (Circle):
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Mainnet USDC:
# USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7EJJUD

# ── Deployed contract IDs (filled in by deploy scripts) ──────────────────────
SOROBAN_FACTORY_CONTRACT_ID=
SOROBAN_SETTLEMENT_CONTRACT_ID=
SOROBAN_DISTRIBUTOR_CONTRACT_ID=

# ── Optional overrides ────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=200
